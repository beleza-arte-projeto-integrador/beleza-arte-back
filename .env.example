# Copie este arquivo para .env e preencha com os dados do banco (peça para alguém do grupo).
# O .env não vai para o git.
DB_URL=jdbc:postgresql://SEU_HOST:5432/SEU_BANCO?sslmode=require
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# --- Banco LOCAL (Docker) para testes: docker compose up -d --build ---
# Para usar, troque as três linhas DB_URL/DB_USERNAME/DB_PASSWORD acima por estas:
# DB_URL=jdbc:postgresql://localhost:5433/salaobeleza
# DB_USERNAME=dev
# DB_PASSWORD=dev
